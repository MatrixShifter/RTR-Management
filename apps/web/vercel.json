{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/reset-password",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/products/:id/usage",
      "destination": "/api/products/:id/usage"
    },
    {
      "source": "/api/products/:id",
      "destination": "/api/products/:id"
    },
    {
      "source": "/api/shops/:id/usage",
      "destination": "/api/shops/:id/usage"
    },
    {
      "source": "/api/shops/:id",
      "destination": "/api/shops/:id"
    },
    {
      "source": "/api/employees/:id/reset-password",
      "destination": "/api/employees/:id/reset-password"
    },
    {
      "source": "/api/employees/:id/shop",
      "destination": "/api/employees/:id/shop"
    },
    {
      "source": "/api/employees/:id/status",
      "destination": "/api/employees/:id/status"
    },
    {
      "source": "/api/employees/:id",
      "destination": "/api/employees/:id"
    },
    {
      "source": "/api/employees",
      "destination": "/api/employees"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
