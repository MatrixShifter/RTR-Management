{
  "name": "crimpston-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Production Wholesale Mobile Accessories Management System",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "dev:api": "npm run dev --workspace=@crimpston/api",
    "dev:web": "npm run dev --workspace=@crimpston/web",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
