# Central Environment Configuration Example (Placeholders Only - Never commit actual secrets)

# Server API Environment
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173

# Supabase Managed Service Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Frontend Web Environment (Vite requires VITE_ prefix for exposed browser variables)
VITE_API_URL=http://localhost:4000/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
